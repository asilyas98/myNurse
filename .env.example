# Browser-safe (bundled into the frontend)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Your live Netlify address — the iOS app calls the AI function here (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
# Shown on the privacy policy page (optional but recommended for the App Store)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server only (Netlify environment variables — never prefix with VITE_ or NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
